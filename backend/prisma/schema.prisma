generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  STAFF
  DRIVER
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum TripStatus {
  LOADING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
}

enum TripCrewRole {
  DRIVER
  HELPER
}

enum ShiftStatus {
  ACTIVE
  ON_BREAK
  ENDED
}

enum ProblemCategory {
  VEHICLE
  CUSTOMER
  STOCK
  OTHER
}

enum ProblemStatus {
  OPEN
  RESOLVED
}

enum TankStatus {
  NORMAL
  NEEDS_REPLACEMENT
}

enum TripStopStatus {
  PENDING
  DONE
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  username  String   @unique
  password  String
  role      UserRole @default(DRIVER)
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trips            Trip[]          @relation("DriverTrips")
  crewOf           TripCrew[]
  shifts           Shift[]
  problemReports   ProblemReport[]
  createdTripStops TripStop[]      @relation("CreatedTripStops")
}

model Vehicle {
  id        Int           @id @default(autoincrement())
  name      String
  plate     String        @unique
  status    VehicleStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  trips   Trip[]
  gpsLogs GpsLog[]
}

model IceProduct {
  id        Int      @id @default(autoincrement())
  name      String
  unit      String   @default("กระสอบ")
  price     Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tripItems     TripItem[]
  deliveryItems DeliveryItem[]
}

model Trip {
  id          Int        @id @default(autoincrement())
  vehicleId   Int
  driverId    Int
  status      TripStatus @default(LOADING)
  startTime   DateTime?
  endTime     DateTime?
  totalAmount Decimal    @default(0) @db.Decimal(12, 2)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  vehicle        Vehicle         @relation(fields: [vehicleId], references: [id])
  driver         User            @relation("DriverTrips", fields: [driverId], references: [id])
  items          TripItem[]
  deliveries     Delivery[]
  gpsLogs        GpsLog[]
  crew           TripCrew[]
  shifts         Shift[]
  problemReports ProblemReport[]
  stops          TripStop[]
}

model Delivery {
  id            Int           @id @default(autoincrement())
  tripId        Int
  customerId    Int?
  customerName  String?
  village       String?
  latitude      Float?
  longitude     Float?
  totalAmount   Decimal       @default(0) @db.Decimal(12, 2)
  paymentStatus PaymentStatus @default(PENDING)
  deliveredAt   DateTime      @default(now())
  createdAt     DateTime      @default(now())

  trip     Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  customer Customer?      @relation(fields: [customerId], references: [id])
  items    DeliveryItem[]
}

model DeliveryItem {
  id           Int     @id @default(autoincrement())
  deliveryId   Int
  iceProductId Int
  quantity     Int
  unitPrice    Decimal @db.Decimal(10, 2)
  totalPrice   Decimal @db.Decimal(12, 2)

  delivery   Delivery   @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  iceProduct IceProduct @relation(fields: [iceProductId], references: [id])
}

model GpsLog {
  id         Int      @id @default(autoincrement())
  vehicleId  Int
  tripId     Int?
  latitude   Float
  longitude  Float
  speed      Float?
  accuracy   Float?
  heading    Float?
  recordedAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  trip    Trip?   @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([vehicleId, recordedAt])
  @@index([tripId, recordedAt])
}

model TripItem {
  id           Int @id @default(autoincrement())
  tripId       Int
  iceProductId Int

  loadedQuantity    Int
  deliveredQuantity Int @default(0)
  remainingQuantity Int

  trip       Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  iceProduct IceProduct @relation(fields: [iceProductId], references: [id])

  @@unique([tripId, iceProductId])
  @@map("trip_items")
}

model Zone {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  villages Village[]

  @@map("zones")
}

model Village {
  id        Int      @id @default(autoincrement())
  zoneId    Int
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zone      Zone       @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  customers Customer[]

  @@index([zoneId])
  @@map("villages")
}

model Customer {
  id        Int      @id @default(autoincrement())
  villageId Int
  name      String
  phone     String?
  latitude  Float?
  longitude Float?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  village    Village    @relation(fields: [villageId], references: [id], onDelete: Cascade)
  iceTanks   IceTank[]
  deliveries Delivery[]
  tripStops  TripStop[]

  @@index([villageId])
  @@map("customers")
}

model IceTank {
  id         Int        @id @default(autoincrement())
  customerId Int
  size       String
  quantity   Int        @default(1)
  status     TankStatus @default(NORMAL)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("ice_tanks")
}

model TripCrew {
  tripId     Int
  userId     Int
  roleOnTrip TripCrewRole @default(HELPER)
  joinedAt   DateTime     @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@id([tripId, userId])
  @@map("trip_crew")
}

model Shift {
  id        Int         @id @default(autoincrement())
  tripId    Int
  userId    Int
  status    ShiftStatus @default(ACTIVE)
  startedAt DateTime    @default(now())
  endedAt   DateTime?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([tripId])
  @@index([userId])
  @@map("shifts")
}

model ProblemReport {
  id          Int             @id @default(autoincrement())
  tripId      Int
  userId      Int
  category    ProblemCategory @default(OTHER)
  description String          @db.Text
  status      ProblemStatus   @default(OPEN)
  latitude    Float?
  longitude   Float?
  createdAt   DateTime        @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([tripId])
  @@map("problem_reports")
}

model TripStop {
  id          Int             @id @default(autoincrement())
  tripId      Int
  customerId  Int
  note        String?
  status      TripStopStatus  @default(PENDING)
  createdById Int
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy User     @relation("CreatedTripStops", fields: [createdById], references: [id])

  @@unique([tripId, customerId])
  @@index([tripId])
  @@index([customerId])
  @@map("trip_stops")
}
