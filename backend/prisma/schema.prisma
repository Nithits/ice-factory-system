generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  STAFF
  DRIVER
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum TripStatus {
  LOADING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  username  String   @unique
  password  String
  role      UserRole @default(DRIVER)
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trips     Trip[]   @relation("DriverTrips")
}

model Vehicle {
  id        Int           @id @default(autoincrement())
  name      String
  plate     String        @unique
  status    VehicleStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  trips     Trip[]
  gpsLogs   GpsLog[]
}

model IceProduct {
  id        Int      @id @default(autoincrement())
  name      String
  unit      String   @default("กระสอบ")
  price     Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tripItems     TripItem[]
  deliveryItems DeliveryItem[]
}

model Trip {
  id          Int        @id @default(autoincrement())
  vehicleId   Int
  driverId    Int
  status      TripStatus @default(LOADING)
  startTime   DateTime?
  endTime     DateTime?
  totalAmount Decimal    @default(0) @db.Decimal(12, 2)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  vehicle     Vehicle     @relation(fields: [vehicleId], references: [id])
  driver      User        @relation("DriverTrips", fields: [driverId], references: [id])
  items       TripItem[]
  deliveries  Delivery[]
  gpsLogs     GpsLog[]
}

model Delivery {
  id            Int           @id @default(autoincrement())
  tripId        Int
  customerName  String?
  village       String?
  latitude      Float?
  longitude     Float?
  totalAmount   Decimal       @default(0) @db.Decimal(12, 2)
  paymentStatus PaymentStatus @default(PENDING)
  deliveredAt   DateTime      @default(now())
  createdAt     DateTime      @default(now())

  trip          Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items         DeliveryItem[]
}

model DeliveryItem {
  id            Int        @id @default(autoincrement())
  deliveryId    Int
  iceProductId  Int
  quantity      Int
  unitPrice     Decimal    @db.Decimal(10, 2)
  totalPrice    Decimal    @db.Decimal(12, 2)

  delivery      Delivery   @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  iceProduct    IceProduct @relation(fields: [iceProductId], references: [id])
}

model GpsLog {
  id         Int      @id @default(autoincrement())
  vehicleId  Int
  tripId     Int?
  latitude   Float
  longitude  Float
  speed      Float?
  accuracy   Float?
  heading    Float?
  recordedAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  trip    Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([vehicleId, recordedAt])
  @@index([tripId, recordedAt])
}

model TripItem {
  id           Int @id @default(autoincrement())
  tripId       Int
  iceProductId Int

  loadedQuantity    Int
  deliveredQuantity Int @default(0)
  remainingQuantity Int

  trip       Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  iceProduct IceProduct @relation(fields: [iceProductId], references: [id])

  @@unique([tripId, iceProductId])
  @@map("trip_items")
}
